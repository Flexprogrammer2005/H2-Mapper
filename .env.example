# Use a local database from docker-compose.yml or a MongoDB Atlas connection.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=h2_mapper

# Optional: Mapbox access token for satellite imagery in the globe view.
# Get a token from https://account.mapbox.com/access-tokens/ and keep it private.
# Without it, PyDeck falls back to its default basemap.
MAPBOX_API_KEY=

